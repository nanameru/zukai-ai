{
    "manifest_version": 3,
    "name": "Zukai AI",
    "version": "1.0.0",
    "action": {
        "default_title": "Click to open side panel"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "permissions": [
        "sidePanel",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.ts"
            ]
        }
    ]
}